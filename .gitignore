# Godot 4+ specific ignores
.godot/
/android/
.worktrees/*
!.worktrees/.gdignore
.superpowers/
.playwright-cli/
services/agent-service/node_modules/
services/agent-service/dist/
services/agent-service/data/
services/agent-service/config/agent-service.local.json
config/agent-client.local.json

# Local 3D save, recovery backup, Agent checkpoint manifest and atomic-write files.
# Keep data/agents/*.json tracked: those are authored NPC definitions.
/data/farm_3d_save.json*
/data/cache/

# Local validation notes, screenshots and art previews.
/docs/validation/

# Temp files
tmp/
temp/
output/
*.tmp
*.temp
*.log

# Blender backup copies (keep editable .blend sources).
*.blend[0-9]*

# Python tool caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local environment secrets (keep shareable examples).
.env
.env.*
!.env.example
!.env.*.example

# Operating system metadata.
.DS_Store
Thumbs.db
Desktop.ini
