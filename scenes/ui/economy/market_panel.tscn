[gd_scene load_steps=5 format=3]

[ext_resource path="res://scripts/ui/market_panel.gd" type="Script" id="1_market"]
[ext_resource path="res://scripts/ui/market_price_chart.gd" type="Script" id="2_chart"]
[ext_resource path="res://scenes/ui/economy/trade_panel.tscn" type="PackedScene" id="3_trade"]
[ext_resource path="res://assets/ui/economy/economy_theme.tres" type="Theme" id="4_theme"]

[node name="MarketPanel" type="PanelContainer"]
theme_type_variation = &"EconomyCard"
theme = ExtResource("4_theme")
script = ExtResource("1_market")

[node name="Columns" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="CatalogColumn" type="PanelContainer" parent="Columns"]
