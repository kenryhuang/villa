[node name="SellTotalLabel" type="Label" parent="Content/SummaryGrid"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "0"
horizontal_alignment = 2

[node name="ImpactCaption" type="Label" parent="Content/SummaryGrid"]
layout_mode = 2
theme_override_colors/font_color = Color(0.482353, 0.403922, 0.345098, 1)
theme_override_font_sizes/font_size = 18
text = "成交影响"

[node name="ImpactLabel" type="Label" parent="Content/SummaryGrid"]
