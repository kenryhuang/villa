[node name="StatusArea" type="Control" parent="Content"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_vertical = 3

[node name="DisabledReasonLabel" type="Label" parent="Content/StatusArea"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.713726, 0.360784, 0.294118, 1)
theme_override_font_sizes/font_size = 18
autowrap_mode = 2

[node name="FeedbackLabel" type="Label" parent="Content/StatusArea"]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.372549, 0.529412, 0.333333, 1)
theme_override_font_sizes/font_size = 18
text = "交易成功"
autowrap_mode = 2

[node name="Actions" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="BuyButton" type="Button" parent="Content/Actions"]
custom_minimum_size = Vector2(100, 44)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
text = "买入"

[node name="SellButton" type="Button" parent="Content/Actions"]
custom_minimum_size = Vector2(100, 44)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
text = "卖出"

[node name="ConfirmationLayer" type="ColorRect" parent="."]
visible = false
z_index = 100
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0.129412, 0.101961, 0.0862745, 0.28)

[node name="Content" type="PanelContainer" parent="ConfirmationLayer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = 12.0
offset_right = -12.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
theme_type_variation = &"EconomyCompactCard"

[node name="VBox" type="VBoxContainer" parent="ConfirmationLayer/Content"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="TitleLabel" type="Label" parent="ConfirmationLayer/Content/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "确认大额交易"

[node name="FirstUnitLabel" type="Label" parent="ConfirmationLayer/Content/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "首件价格：0"

[node name="LastUnitLabel" type="Label" parent="ConfirmationLayer/Content/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "末件价格：0"

[node name="TotalLabel" type="Label" parent="ConfirmationLayer/Content/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "实际总价：0"

[node name="PressureLabel" type="Label" parent="ConfirmationLayer/Content/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "预计次日供给压力：—"

[node name="Buttons" type="HBoxContainer" parent="ConfirmationLayer/Content/VBox"]
layout_mode = 2

[node name="ConfirmButton" type="Button" parent="ConfirmationLayer/Content/VBox/Buttons"]
custom_minimum_size = Vector2(110, 44)
layout_mode = 2
size_flags_horizontal = 3
focus_next = NodePath("../CancelButton")
focus_previous = NodePath("../CancelButton")
theme_override_colors/font_focus_color = Color(0.317647, 0.231373, 0.184314, 1)
theme_override_font_sizes/font_size = 20
text = "确认"

[node name="CancelButton" type="Button" parent="ConfirmationLayer/Content/VBox/Buttons"]
custom_minimum_size = Vector2(110, 44)
layout_mode = 2
size_flags_horizontal = 3
focus_next = NodePath("../ConfirmButton")
focus_previous = NodePath("../ConfirmButton")
theme_override_colors/font_focus_color = Color(0.317647, 0.231373, 0.184314, 1)
theme_override_font_sizes/font_size = 20
text = "取消"

[node name="FeedbackTimer" type="Timer" parent="."]
wait_time = 1.5
one_shot = true
