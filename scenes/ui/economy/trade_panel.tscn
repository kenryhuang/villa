[gd_scene load_steps=3 format=3]

[ext_resource path="res://scripts/ui/trade_panel.gd" type="Script" id="1_trade"]
[ext_resource path="res://assets/ui/economy/economy_theme.tres" type="Theme" id="2_theme"]

[node name="TradePanel" type="Control"]
custom_minimum_size = Vector2(300, 0)
theme = ExtResource("2_theme")
theme_type_variation = &"EconomyCompactCard"
script = ExtResource("1_trade")

[node name="Background" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"EconomyCompactCard"

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = -16.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"EconomyBlockTitle"
theme_override_font_sizes/font_size = 22
text = "交易操作"

[node name="QuantityRow" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="QuantityLabel" type="Label" parent="Content/QuantityRow"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "数量"

[node name="QuantitySpin" type="SpinBox" parent="Content/QuantityRow"]
custom_minimum_size = Vector2(104, 44)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 2
min_value = 1.0
max_value = 99.0
value = 1.0
allow_greater = false

[node name="MaxButton" type="Button" parent="Content/QuantityRow"]
custom_minimum_size = Vector2(64, 44)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "最大"

[node name="SummaryGrid" type="GridContainer" parent="Content"]
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 8
columns = 2

[node name="PlayerQuantityCaption" type="Label" parent="Content/SummaryGrid"]
layout_mode = 2
theme_override_colors/font_color = Color(0.482353, 0.403922, 0.345098, 1)
theme_override_font_sizes/font_size = 18
text = "持有"

[node name="PlayerQuantityLabel" type="Label" parent="Content/SummaryGrid"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "0"
horizontal_alignment = 2

[node name="MarketQuantityCaption" type="Label" parent="Content/SummaryGrid"]
layout_mode = 2
