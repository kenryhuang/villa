horizontal_alignment = 1

[node name="Details" type="VBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="TitleLabel" type="Label" parent="Content/Details"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "选择合同查看详情"
