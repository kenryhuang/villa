horizontal_alignment = 1

[node name="AvailableTitle" type="Label" parent="Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "可签合同"

[node name="AvailableScroll" type="ScrollContainer" parent="Content"]
layout_mode = 2
size_flags_vertical = 3

[node name="AvailableList" type="VBoxContainer" parent="Content/AvailableScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="AvailableEmpty" type="Label" parent="Content"]
layout_mode = 2
