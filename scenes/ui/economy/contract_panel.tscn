[gd_scene load_steps=3 format=3]

[ext_resource path="res://scripts/ui/contract_panel.gd" type="Script" id="1_contract"]
[ext_resource path="res://assets/ui/economy/economy_theme.tres" type="Theme" id="2_theme"]

[node name="ContractPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
process_mode = 2
theme = ExtResource("2_theme")
script = ExtResource("1_contract")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 6

[node name="ActiveTitle" type="Label" parent="Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "活跃合同"

[node name="ActiveScroll" type="ScrollContainer" parent="Content"]
layout_mode = 2
size_flags_vertical = 3

[node name="ActiveList" type="VBoxContainer" parent="Content/ActiveScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="ActiveEmpty" type="Label" parent="Content"]
layout_mode = 2
