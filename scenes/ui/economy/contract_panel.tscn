[node name="DailyProgressLabel" type="Label" parent="Content/Details"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "今日交付：0/0"

[node name="NextDeadlineLabel" type="Label" parent="Content/Details"]
layout_mode = 2
